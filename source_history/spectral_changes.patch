+
+init_root = Path(os.environ['RLPR_CROSS_INIT_ROOT'])
+run_root = Path(os.environ['RLPR_CROSS_RUN_ROOT'])
+data_root = Path(os.environ['RLPR_MULRAN_DATA'])
