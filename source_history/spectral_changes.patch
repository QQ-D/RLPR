+                           for directory in ('config', 'dataset', 'modules', 'scripts', 'trainer', 'utils', 'tests')
+                           for p in (SOURCE / directory).rglob('*.py')},
+            initialization={m: dict(path=str(INITIAL / f'{m}_mulran/weights/5.pth.tar'),
