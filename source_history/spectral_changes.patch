+"""Temperature must affect the actual loss, with fixed auxiliaries and F1 selection."""
+import importlib
+import unittest
+from types import SimpleNamespace
+
+import torch
+from torch.nn import functional as F
+
+
+class TemperatureTests(unittest.TestCase):
+    def module(self,name):
+        try:return importlib.import_module(name)
+        except ModuleNotFoundError:self.fail('Temperature experiment is not implemented: '+name)
+
+    def test_temperature_changes_real_local_global_loss_and_keeps_teacher_detached(self):
+        m=self.module('trainer.temperature_cross_modal')
+        from tests.test_alignment_ablation import AlignmentAblationTests
+        fixture=AlignmentAblationTests();fixture.setUp()
+        baseline,outputs=fixture.trainer_and_outputs()
+        original,original_parts=baseline._compute_loss(outputs)
+        trainer=m.TemperatureCrossModalTrainer.__new__(m.TemperatureCrossModalTrainer)
+        trainer.__dict__.update(baseline.__dict__)
+        trainer.configure_temperature(.07)
+        control,parts=trainer._compute_loss(outputs)
+        self.assertTrue(torch.equal(control,original))
+        for value in (.03,.10):
+            trainer.configure_temperature(value)
+            loss,parts=trainer._compute_loss(outputs)
+            expected=[]
+            for key in ('local_descriptor','global_descriptor'):
+                logits=F.normalize(outputs[3][key].detach(),dim=1)@F.normalize(outputs[2][key],dim=1).T/value
+                expected.append(F.cross_entropy(logits,torch.arange(12)))
+            torch.testing.assert_close(loss,sum(expected)+.1*original_parts['phase'])
+            torch.testing.assert_close(parts['phase'],original_parts['phase'])
+            self.assertFalse(torch.equal(loss,original))
+        loss.backward()
+        self.assertIsNone(outputs[3]['local_descriptor'].grad)
+        self.assertGreater(float(outputs[2]['local_descriptor'].grad.abs().sum()),0.)
+        for value in (0.,-1.,float('nan'),float('inf')):
+            with self.assertRaises(ValueError):trainer.configure_temperature(value)
+
+    def test_temperature_is_saved_in_actual_training_settings(self):
+        m=self.module('trainer.temperature_cross_modal')
+        trainer=m.TemperatureCrossModalTrainer.__new__(m.TemperatureCrossModalTrainer)
+        trainer.model=SimpleNamespace(model_variant='spectral_word')
+        trainer.params=SimpleNamespace(batch_size=8,phase_loss_weight=.1,cross_fusion_loss_weight=0.,
+            learning_rate=5e-5,sampling_seed=2,word_alignment_loss='infonce')
+        trainer.cross_hard_negative_count=5
+        trainer.configure_temperature(.03)
+        self.assertEqual(trainer._training_settings()['contrastive_temperature'],.03)
+        trainer.configure_temperature(.10)
+        self.assertEqual(trainer._training_settings()['contrastive_temperature'],.10)
+
+    def test_all_nine_validations_are_required_and_test_scores_do_not_select(self):
+        m=self.module('scripts.temperature_ablation')
+        rows={a:{str(s):{'validation':{'F1':v,'Recall@1':70.}} for s in (0,1,2)}
+              for a,v in [('tau_003',.88),('tau_007',.87),('tau_010',.86)]}
+        rows['tau_010']['0']['benchmarks']={'riverside':{'F1':1.}}
+        self.assertEqual(m.choose_temperature(rows),'tau_003')
+        for row in rows['tau_007'].values():row['validation']['F1']=.88
+        self.assertEqual(m.choose_temperature(rows),'tau_007')
+        del rows['tau_010']['2']
+        with self.assertRaises(ValueError):m.choose_temperature(rows)
+
+    def test_checkpoint_audit_rejects_wrong_temperature_and_wrong_seed(self):
+        m=self.module('scripts.temperature_ablation')
+        import os
+        import tempfile
+        from pathlib import Path
+        with tempfile.TemporaryDirectory() as tmp:
+            path=Path(tmp)/'1.pt';teacher=Path(tmp)/'r.pt'
+            state={'weight_l':torch.tensor([1.]),'weight_r':torch.tensor([2.])}
+            settings=dict(alignment_loss='infonce',batch_size=8,phase_loss_weight=.1,cross_fusion_loss_weight=0.,
+                learning_rate_initial=5e-5,scheduler_gamma=.8,deterministic_algorithms=True,cublas_workspace_config=':4096:8',
+                cross_hard_negative_count=5,sampling_seed=2,contrastive_temperature=.03)
+            saved=dict(epoch=1,model_variant='spectral_word',state_dict=state,alignment_loss='infonce',
+                optimizer={'state':{0:{'step':torch.tensor(2071.),'exp_avg':torch.tensor([.1])}}},scheduler={'last_epoch':1},
+                spectral_config={'pure_phase':False},cross_fusion_enabled=True,training_settings=settings,
+                training_state={'sampler_generator':torch.Generator().manual_seed(2).get_state(),
+                                'loader_generator':torch.Generator().manual_seed(2).get_state()})
+            torch.save(saved,path);torch.save({'state_dict':{'weight_r':state['weight_r']}},teacher)
+            self.assertEqual(m.audit_temperature(path,.03,2,teacher)['optimizer_steps'],2071)
+            with self.assertRaises(ValueError):m.audit_temperature(path,.10,2,teacher)
+            with self.assertRaises(ValueError):m.audit_temperature(path,.03,1,teacher)
+
+
+if __name__=='__main__':unittest.main()
diff --git a/tests/test_training_control.py b/tests/test_training_control.py
new file mode 100644
index 0000000..97617d5
--- /dev/null
+++ b/tests/test_training_control.py
@@ -0,0 +1,126 @@
+import copy
+import importlib.util
+import os
+import random
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader, Dataset
+
+from scripts.registry import build_params
+from trainer.cross_modal import CrossModalTrainer
+from utils.seed import set_global_seed
+
+
+class StochasticSamples(Dataset):
+    def __len__(self):
+        return 12
+
+    def __getitem__(self, index):
+        return torch.tensor([index / 12., random.random(), float(np.random.rand()), float(torch.rand(()))])
+
+
+class TrainingControlTests(unittest.TestCase):
+    def setUp(self):
+        torch.set_num_threads(2)
+
+    def test_environment_overrides_stage_default_and_cli_overrides_environment(self):
+        with patch.dict(os.environ, {'RLPR_TRAINING_ROOT': '', 'RLPR_EPOCHS': '10'}):
+            self.assertEqual(build_params(1).epochs, 10)
+            self.assertEqual(build_params(5).epochs, 10)
+            self.assertEqual(build_params(1, epochs_override=3).epochs, 3)
+
+    def test_defaults_are_unchanged_and_invalid_epoch_counts_are_rejected(self):
+        with patch.dict(os.environ, {'RLPR_TRAINING_ROOT': ''}):
+            os.environ.pop('RLPR_EPOCHS', None)
+            self.assertEqual(build_params(1).epochs, 1)
+            self.assertEqual(build_params(5).epochs, 5)
+            for value in ('0', '-1', '1.5', 'bad'):
+                with self.subTest(value=value), patch.dict(os.environ, {'RLPR_EPOCHS': value}):
+                    with self.assertRaisesRegex(ValueError, 'epoch'):
+                        build_params(1)
+
+    def test_completed_target_is_rejected_instead_of_silently_skipping_training(self):
+        trainer = CrossModalTrainer.__new__(CrossModalTrainer)
+        trainer.params = SimpleNamespace(epochs=1)
+        trainer._init_weights = lambda: 1
+        with self.assertRaisesRegex(ValueError, 'epoch'):
+            trainer.do_train()
+
+    def test_strict_reproducibility_requires_workspace_and_enables_deterministic_algorithms(self):
+        previous = torch.are_deterministic_algorithms_enabled()
+        try:
+            with patch.dict(os.environ, {'RLPR_DETERMINISTIC': '1', 'CUBLAS_WORKSPACE_CONFIG': ''}):
+                with self.assertRaisesRegex(ValueError, 'CUBLAS_WORKSPACE_CONFIG'):
+                    set_global_seed(0)
+            with patch.dict(os.environ, {'RLPR_DETERMINISTIC': '1', 'CUBLAS_WORKSPACE_CONFIG': ':4096:8'}):
+                set_global_seed(0)
+                self.assertTrue(torch.are_deterministic_algorithms_enabled())
+        finally:
+            torch.use_deterministic_algorithms(previous)
+
+    def state_module(self):
+        self.assertIsNotNone(importlib.util.find_spec('utils.training_state'),
+                             'Reproducible epoch-boundary training state is missing')
+        from utils import training_state
+        return training_state
+
+    def test_resume_matches_uninterrupted_shuffled_stochastic_training(self):
+        state = self.state_module()
+        for workers in (0, 1):
+            with self.subTest(workers=workers):
+                def create():
+                    random.seed(11); np.random.seed(11); torch.manual_seed(11)
+                    loader = DataLoader(StochasticSamples(), batch_size=4, shuffle=True, num_workers=workers)
+                    state.configure_sampling(loader, 0)
+                    model = torch.nn.Sequential(torch.nn.Linear(4, 8), torch.nn.Dropout(.25), torch.nn.Linear(8, 1))
+                    optimizer = torch.optim.Adam(model.parameters(), lr=.005)
+                    scheduler = torch.optim.lr_scheduler.StepLR(optimizer, 1, gamma=.8)
+                    return loader, model, optimizer, scheduler
+                def epoch(loader, model, optimizer, scheduler):
+                    values = []
+                    for x in loader:
+                        optimizer.zero_grad()
+                        loss = (model(x).flatten() - x[:, 0]).square().mean()
+                        loss.backward(); optimizer.step(); values.append(loss.detach().clone())
+                    scheduler.step()
+                    return torch.stack(values)
+                loader, model, optimizer, scheduler = create()
+                epoch(loader, model, optimizer, scheduler)
+                expected = epoch(loader, model, optimizer, scheduler)
+                expected_weights = copy.deepcopy(model.state_dict())
+                expected_lr = optimizer.param_groups[0]['lr']
+                loader, model, optimizer, scheduler = create()
+                epoch(loader, model, optimizer, scheduler)
+                checkpoint = copy.deepcopy(dict(model=model.state_dict(), optimizer=optimizer.state_dict(),
+                                                scheduler=scheduler.state_dict(), rng=state.capture_training_state(loader)))
+                loader, model, optimizer, scheduler = create()
+                model.load_state_dict(checkpoint['model']); optimizer.load_state_dict(checkpoint['optimizer'])
+                scheduler.load_state_dict(checkpoint['scheduler'])
+                random.random(); np.random.rand(); torch.rand(17)
+                self.assertTrue(state.restore_training_state(checkpoint['rng'], loader))
+                actual = epoch(loader, model, optimizer, scheduler)
+                torch.testing.assert_close(actual, expected, atol=0, rtol=0)
+                for key, value in expected_weights.items():
+                    torch.testing.assert_close(model.state_dict()[key], value, atol=0, rtol=0)
+                self.assertEqual(optimizer.param_groups[0]['lr'], expected_lr)
+
+    def test_resume_settings_allow_more_epochs_but_reject_changed_objective(self):
+        state = self.state_module()
+        checkpoint = {'training_settings': {'alignment_loss': 'signed_coherency_v2', 'batch_size': 8}}
+        state.validate_training_settings(checkpoint, {'alignment_loss': 'signed_coherency_v2', 'batch_size': 8})
+        with self.assertRaisesRegex(ValueError, 'alignment_loss'):
+            state.validate_training_settings(checkpoint, {'alignment_loss': 'infonce', 'batch_size': 8})
+        for key, saved, requested in (('alignment_loss', 'infonce', 'signed_coherency_v2'),
+                                      ('phase_loss_weight', .1, .5),
+                                      ('cross_fusion_loss_weight', .5, .2)):
+            with self.subTest(legacy_key=key), self.assertRaisesRegex(ValueError, key):
+                state.validate_training_settings({key: saved}, {key: requested})
+        self.assertFalse(state.restore_training_state(None, DataLoader(StochasticSamples())))
+
+
+if __name__ == '__main__':
+    unittest.main()
