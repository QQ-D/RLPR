+        cross_fusion_loss_weight=0.,learning_rate_initial=5e-5,scheduler_gamma=.8,
+        deterministic_algorithms=True,cublas_workspace_config=':4096:8',
+        cross_hard_negative_count=5,sampling_seed=seed)
