+def phase_coherence_loss(phase_radar, phase_lidar, weights=None):
+    """Circular phase consistency for already corresponding features.
+
+    Radar is a detached teacher. This is not a magnitude-squared spectral
+    coherence estimator and does not compensate for pose differences.
+    """
+    if phase_radar.shape != phase_lidar.shape:
+        raise ValueError('Radar and LiDAR phase shapes must match')
+    difference = phase_lidar - phase_radar.detach()
+    error = 1. - torch.cos(difference)
+    if weights is None:
+        return error.mean()
+    if weights.shape != error.shape:
+        raise ValueError('Phase confidence shape must match phase')
+    confidence = weights.detach().clamp_min(0)
+    return (error * confidence).sum() / confidence.sum().clamp_min(1e-6)
+
